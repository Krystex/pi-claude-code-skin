{
  "name": "pi-claude-code-skin",
  "version": "0.1.0",
  "description": "Claude Code look for the pi coding agent: pixel-logo header, banner, ❯ editor prompt, status footer, and a clay palette",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi-theme"
  ],
  "files": [
    "extensions",
    "themes",
    "README.md"
  ],
  "pi": {
    "extensions": [
      "./extensions/claude-code.ts"
    ],
    "themes": [
      "./themes/claude-code.json"
    ]
  },
  "scripts": {
    "dev": "pi --theme ./themes/claude-code.json -e ./extensions/claude-code.ts",
    "install-local": "pi install .",
    "check": "tsc --noEmit"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^1.0.3",
    "@earendil-works/pi-coding-agent": "^1.0.3",
    "@earendil-works/pi-tui": "^1.0.3",
    "@types/node": "^26.6.4",
    "typescript": "^5.9.3"
  }
}
